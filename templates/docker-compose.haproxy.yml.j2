# Rendered by roles/load_balancer - generated by Ansible, do not edit by
# hand.
services:
  cockroachdb-haproxy:
    image: "haproxy:3.2.13-alpine"
    container_name: cockroachdb-haproxy
    # Same reasoning as templates/docker-compose.yml.j2: needs to reach
    # every node at advertise_addr:port, which on this sandbox's own
    # same-machine demo means "localhost" - only resolvable correctly
    # under host networking, not bridge+port-publishing.
    network_mode: host
    cap_drop:
      - ALL
    security_opt:
      - "no-new-privileges:true"
    restart: unless-stopped
    volumes:
      - "{{ cockroach_lb_compose_root }}/haproxy.cfg:/usr/local/etc/haproxy/haproxy.cfg:ro"
