# Rendered by roles/monitoring - generated by Ansible, do not edit by
# hand.
services:
  cockroachdb-prometheus:
    image: "prom/prometheus:latest"
    container_name: cockroachdb-prometheus
    # Host networking - same reasoning as templates/docker-compose.yml.j2
    # (needs to reach every node at advertise_addr:port, "localhost" on
    # this sandbox's own same-machine demo).
    network_mode: host
    cap_drop:
      - ALL
    security_opt:
      - "no-new-privileges:true"
    restart: unless-stopped
    command:
      - "--config.file=/etc/prometheus/prometheus.yml"
      - "--web.listen-address=0.0.0.0:{{ cockroach_prometheus_port }}"
    volumes:
      - "{{ cockroach_monitoring_compose_root }}/prometheus.yml:/etc/prometheus/prometheus.yml:ro"
      - cockroachdb-prometheus-data:/prometheus

  cockroachdb-grafana:
    image: "grafana/grafana:latest"
    container_name: cockroachdb-grafana
    network_mode: host
    cap_drop:
      - ALL
    security_opt:
      - "no-new-privileges:true"
    restart: unless-stopped
    environment:
      GF_SERVER_HTTP_PORT: "{{ cockroach_grafana_port }}"
      GF_AUTH_ANONYMOUS_ENABLED: "true"
      GF_AUTH_ANONYMOUS_ORG_ROLE: "Viewer"
    volumes:
      - "{{ cockroach_monitoring_compose_root }}/grafana-datasource.yml:/etc/grafana/provisioning/datasources/datasource.yml:ro"
      - "{{ cockroach_monitoring_compose_root }}/grafana-dashboard-provider.yml:/etc/grafana/provisioning/dashboards/provider.yml:ro"
      - "{{ cockroach_monitoring_compose_root }}/grafana-cockroachdb-dashboard.json:/etc/grafana/provisioning/dashboards/cockroachdb.json:ro"
      - cockroachdb-grafana-data:/var/lib/grafana

volumes:
  cockroachdb-prometheus-data:
    name: cockroachdb-prometheus-data
  cockroachdb-grafana-data:
    name: cockroachdb-grafana-data
