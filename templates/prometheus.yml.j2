# Rendered by roles/monitoring - generated by Ansible, do not edit by
# hand.
global:
  scrape_interval: 15s

scrape_configs:
  - job_name: cockroachdb
    metrics_path: /_status/vars
    scheme: https
    tls_config:
      # Self-signed cluster CA, not configured here - acceptable for
      # this sandbox; production hardening is ca_file pointing at the
      # real CA instead (documented in docs/architecture.md).
      insecure_skip_verify: true
    static_configs:
      - targets:
{% for h in groups['cockroach_nodes'] %}
{%   for n in hostvars[h].cockroach_local_nodes %}
          - "{{ n.advertise_addr }}:{{ n.http_port }}"
{%   endfor %}
{% endfor %}
