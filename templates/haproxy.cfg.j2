# Rendered by roles/load_balancer - generated by Ansible, do not edit by
# hand. Fronts the whole cockroach_nodes cluster on one stable SQL
# endpoint so applications never depend on any single node's address
# directly, and stop receiving new connections routed to a node that's
# down.
global
    maxconn 4096

defaults
    log global
    mode tcp
    timeout connect 5s
    timeout client 30s
    timeout server 30s

listen stats
    bind *:{{ cockroach_lb_stats_port }}
    mode http
    stats enable
    stats uri /
    stats refresh 10s

listen cockroachdb-sql
    bind *:{{ cockroach_lb_sql_port }}
    mode tcp
    balance roundrobin
    # /health?ready=1, not plain /health - a node that's up but not
    # cluster-ready shouldn't receive SQL traffic. check-ssl verify none:
    # the admin/HTTP port is TLS (this cluster is never --insecure), and
    # HAProxy doesn't have the cluster's self-signed CA configured here -
    # acceptable for a liveness probe, not a security-sensitive check.
    option httpchk GET /health?ready=1
    http-check expect status 200
{% for h in groups['cockroach_nodes'] %}
{%   for n in hostvars[h].cockroach_local_nodes %}
    server {{ n.name }} {{ n.advertise_addr }}:{{ n.sql_port }} check port {{ n.http_port }} check-ssl verify none
{%   endfor %}
{% endfor %}
