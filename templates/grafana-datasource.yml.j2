# Rendered by roles/monitoring - generated by Ansible, do not edit by
# hand. Grafana runs network_mode: host (same reasoning as
# templates/docker-compose.yml.j2), so it reaches Prometheus at
# localhost:<port> directly.
apiVersion: 1
datasources:
  - name: Prometheus
    type: prometheus
    access: proxy
    url: "http://localhost:{{ cockroach_prometheus_port }}"
    isDefault: true
    editable: false
