# Rendered by roles/cockroach_backup - generated by Ansible, do not edit
# by hand. Same chown-init-container fix already proven for real in
# gitlab-backup-with-jenkins-ansible's own RustFS service: fresh named
# Docker volumes are created root-owned, which RustFS's non-root uid
# can't write to until chowned first.
services:
  rustfs-volume-init:
    image: "busybox:latest"
    command: chown -R 10001:10001 /data/rustfs0 /app/logs
    volumes:
      - cockroachdb-rustfs-data:/data/rustfs0
      - cockroachdb-rustfs-logs:/app/logs

  rustfs:
    image: "rustfs/rustfs:latest"
    container_name: cockroachdb-rustfs
    security_opt:
      - "no-new-privileges:true"
    restart: unless-stopped
    depends_on:
      rustfs-volume-init:
        condition: service_completed_successfully
    network_mode: host
    environment:
      RUSTFS_VOLUMES: "/data/rustfs0"
      RUSTFS_ADDRESS: "0.0.0.0:{{ cockroach_backup_endpoint | regex_replace('^https?://[^:]*:', '') }}"
      RUSTFS_CONSOLE_ADDRESS: "0.0.0.0:{{ cockroach_backup_console_port }}"
      RUSTFS_CONSOLE_ENABLE: "true"
      RUSTFS_ACCESS_KEY: "{{ cockroach_backup_access_key }}"
      RUSTFS_SECRET_KEY: "{{ cockroach_backup_secret_key }}"
      RUSTFS_OBS_LOGGER_LEVEL: "info"
      # Single-disk sandbox - see the identical note in
      # gitlab-backup-with-jenkins-ansible's own docker-compose.rustfs.yml.
      RUSTFS_UNSAFE_BYPASS_DISK_CHECK: "true"
    volumes:
      - cockroachdb-rustfs-data:/data/rustfs0
      - cockroachdb-rustfs-logs:/app/logs
    healthcheck:
      test: ["CMD", "curl", "-fsS", "http://127.0.0.1:{{ cockroach_backup_endpoint | regex_replace('^https?://[^:]*:', '') }}/health"]
      interval: 10s
      timeout: 10s
      retries: 6
      start_period: 40s

volumes:
  cockroachdb-rustfs-data:
    name: cockroachdb-rustfs-data
  cockroachdb-rustfs-logs:
    name: cockroachdb-rustfs-logs
